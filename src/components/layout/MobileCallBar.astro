---
import { Icon } from "astro-icon/components";
import { site } from "@/site.config";
---

<div class="fixed inset-x-0 bottom-0 z-30 grid grid-cols-2 gap-2 border-t border-line bg-white/95 p-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] shadow-[0_-4px_12px_rgb(0_0_0/0.06)] backdrop-blur lg:hidden">
  <a
    href={`tel:${site.phoneE164}`}
    class="flex min-h-12 items-center justify-center gap-2 rounded-lg bg-primary font-heading font-semibold text-white"
  >
    <Icon name="lucide:phone" class="size-5" aria-hidden="true" />
    Call <span class="sr-only">{site.phone}</span>
  </a>
  <a
    href="/contact"
    class="flex min-h-12 items-center justify-center gap-2 rounded-lg bg-accent font-heading font-semibold text-ink"
  >
    <Icon name="lucide:clipboard-list" class="size-5" aria-hidden="true" />
    Get Estimate
  </a>
</div>
