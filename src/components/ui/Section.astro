---
import type { HTMLAttributes } from "astro/types";
import Container from "./Container.astro";

interface Props extends HTMLAttributes<"section"> {
  tone?: "white" | "surface" | "primary";
}

const { tone = "white", class: className, ...rest } = Astro.props;

const tones = {
  white: "bg-white",
  surface: "bg-surface",
  primary: "bg-primary text-white",
};
---

<section class:list={["py-16 lg:py-24", tones[tone], className]} {...rest}>
  <Container>
    <slot />
  </Container>
</section>
