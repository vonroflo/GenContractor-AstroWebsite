---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"span"> {
  tone?: "light" | "dark";
}

const { tone = "light", class: className, ...rest } = Astro.props;

const tones = {
  light: "bg-primary-light text-primary",
  dark: "bg-white/10 text-white",
};
---

<span
  class:list={[
    "inline-flex items-center gap-1.5 rounded-full px-3 py-1 font-heading text-xs font-semibold tracking-wider uppercase",
    tones[tone],
    className,
  ]}
  {...rest}
>
  <slot />
</span>
