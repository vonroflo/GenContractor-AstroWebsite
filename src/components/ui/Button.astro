---
import type { HTMLAttributes } from "astro/types";

type Variant = "accent" | "primary" | "outline" | "ghost" | "inverse";
type Size = "sm" | "md" | "lg";

interface Props extends Omit<HTMLAttributes<"a">, "href"> {
  href: string;
  variant?: Variant;
  size?: Size;
}

const { href, variant = "accent", size = "md", class: className, ...rest } = Astro.props;

// Accent buttons use dark ink text: white on the default accent is below 4.5:1.
const variants: Record<Variant, string> = {
  accent: "bg-accent text-ink hover:bg-accent-dark hover:text-white",
  primary: "bg-primary text-white hover:bg-primary-dark",
  outline: "border-2 border-current text-primary hover:bg-primary-light",
  ghost: "text-primary hover:bg-primary-light",
  inverse: "border-2 border-white/70 text-white hover:bg-white/10",
};

const sizes: Record<Size, string> = {
  sm: "min-h-10 px-4 text-sm",
  md: "min-h-12 px-5 text-base",
  lg: "min-h-14 px-7 text-lg",
};
---

<a
  href={href}
  class:list={[
    "inline-flex items-center justify-center gap-2 rounded-lg font-heading font-semibold transition-colors",
    variants[variant],
    sizes[size],
    className,
  ]}
  {...rest}
>
  <slot />
</a>
