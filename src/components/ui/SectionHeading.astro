---
interface Props {
  id?: string | undefined;
  heading: string;
  intro?: string | undefined;
  align?: "left" | "center";
}

const { id, heading, intro, align = "left" } = Astro.props;
---

<div class:list={["max-w-2xl", align === "center" && "mx-auto text-center"]}>
  <h2 id={id} class="text-3xl font-bold sm:text-4xl">
    {heading}
  </h2>
  {intro && <p class="mt-4 text-lg text-muted">{intro}</p>}
</div>
