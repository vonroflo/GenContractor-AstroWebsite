---
import { Icon } from "astro-icon/components";

interface Props {
  items: { q: string; a: string }[];
}

// Questions are plain text, not headings: <summary> has a button role, which
// strips heading semantics for assistive tech anyway.
const { items } = Astro.props;
---

<div class="divide-y divide-line rounded-xl border border-line bg-white">
  {items.map((item) => (
    <details class="group">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-heading font-semibold hover:bg-surface sm:text-lg [&::-webkit-details-marker]:hidden">
        {item.q}
        <Icon
          name="lucide:chevron-down"
          class="size-5 shrink-0 text-primary transition-transform group-open:rotate-180"
          aria-hidden="true"
        />
      </summary>
      <div class="px-5 pb-5 text-muted">
        <p>{item.a}</p>
      </div>
    </details>
  ))}
</div>
