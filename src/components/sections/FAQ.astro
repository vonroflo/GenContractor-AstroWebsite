---
import { site } from "@/site.config";
import Section from "@/components/ui/Section.astro";
import Accordion from "@/components/ui/Accordion.astro";

interface Props {
  heading: string;
  items: { q: string; a: string }[];
  tone?: "white" | "surface";
}

const { heading, items, tone = "white" } = Astro.props;
---

<Section tone={tone} aria-labelledby="faq-heading">
  <div class="grid gap-10 lg:grid-cols-[1fr_2fr]">
    <div>
      <h2 id="faq-heading" class="text-3xl font-bold sm:text-4xl">
        {heading}
      </h2>
      <p class="mt-4 text-muted">
        Still have questions? Call us at
        <a
          href={`tel:${site.phoneE164}`}
          class="font-semibold whitespace-nowrap text-primary underline underline-offset-4"
        >
          {site.phone}
        </a>
      </p>
    </div>
    <Accordion items={items} />
  </div>
</Section>
