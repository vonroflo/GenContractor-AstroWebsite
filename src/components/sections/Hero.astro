---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { Icon } from "astro-icon/components";
import { site } from "@/site.config";
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";

interface Props {
  eyebrow: string;
  heading: string;
  subheading: string;
  image: ImageMetadata;
  imageAlt: string;
  points?: string[];
}

const { eyebrow, heading, subheading, image, imageAlt, points = [] } = Astro.props;
---

<section class="relative overflow-hidden bg-primary text-white">
  <Picture
    src={image}
    alt={imageAlt}
    formats={["avif", "webp"]}
    widths={[640, 960, 1280, 1600]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 size-full object-cover opacity-30"
  />
  <div
    class="absolute inset-0 bg-gradient-to-r from-primary-dark via-primary-dark/85 to-primary-dark/40"
    aria-hidden="true"
  ></div>

  <Container class="relative py-20 lg:py-32">
    <div class="max-w-3xl">
      <Badge tone="dark">{eyebrow}</Badge>
      <h1 class="mt-5 text-4xl font-extrabold text-white sm:text-5xl lg:text-6xl">{heading}</h1>
      <p class="mt-6 text-lg text-white/85 sm:text-xl">{subheading}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="/contact" size="lg">
          Get a Free Estimate
        </Button>
        <Button href={`tel:${site.phoneE164}`} size="lg" variant="inverse">
          <Icon name="lucide:phone" class="size-5" aria-hidden="true" />
          {site.phone}
        </Button>
      </div>
      {points.length > 0 && (
        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-white/90">
          {points.map((p) => (
            <li class="flex items-center gap-2">
              <Icon
                name="lucide:circle-check"
                class="size-4 text-accent-light"
                aria-hidden="true"
              />
              {p}
            </li>
          ))}
        </ul>
      )}
    </div>
  </Container>
</section>
