---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import Section from "@/components/ui/Section.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";

export interface GalleryImage {
  src: ImageMetadata;
  alt: string;
  /** Optional caption link, e.g. to the related service page. */
  caption?: { text: string; href: string } | undefined;
}

interface Props {
  heading: string;
  intro?: string | undefined;
  images: GalleryImage[];
  tone?: "white" | "surface";
}

const { heading, intro, images, tone = "white" } = Astro.props;
---

{images.length > 0 && (
  <Section tone={tone} aria-labelledby="gallery-heading">
    <SectionHeading id="gallery-heading" heading={heading} intro={intro} />
    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {images.map((img) => (
        <li>
          <figure>
            <Picture
              src={img.src}
              alt={img.alt}
              formats={["avif", "webp"]}
              widths={[400, 800, 1200]}
              sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw"
              class="aspect-[4/3] w-full rounded-xl object-cover"
            />
            {img.caption && (
              <figcaption class="mt-3 text-sm">
                <a
                  href={img.caption.href}
                  class="font-semibold text-primary underline-offset-4 hover:underline"
                >
                  {img.caption.text}
                </a>
              </figcaption>
            )}
          </figure>
        </li>
      ))}
    </ul>
  </Section>
)}
