---
import { Icon } from "astro-icon/components";
import Container from "@/components/ui/Container.astro";

interface Props {
  items: { icon: string; label: string }[];
}

const { items } = Astro.props;
---

<section aria-label="Why you can trust us" class="border-b border-line bg-surface">
  <Container>
    <ul class="grid grid-cols-2 gap-x-4 gap-y-5 py-6 lg:grid-cols-4">
      {items.map((item) => (
        <li class="flex items-center gap-3 font-heading text-sm font-semibold sm:text-base">
          <Icon
            name={`lucide:${item.icon}`}
            class="size-6 shrink-0 text-primary"
            aria-hidden="true"
          />
          {item.label}
        </li>
      ))}
    </ul>
  </Container>
</section>
