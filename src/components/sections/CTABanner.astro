---
import { Icon } from "astro-icon/components";
import { site } from "@/site.config";
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";

interface Props {
  heading?: string;
  text?: string;
}

const {
  heading = "Ready to get started?",
  text = `Get a free, no-obligation estimate from a licensed contractor serving ${site.address.locality} and nearby cities.`,
} = Astro.props;
---

<section class="bg-primary py-16 text-white">
  <Container class="flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-center">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-bold text-white">{heading}</h2>
      <p class="mt-3 text-lg text-white/85">{text}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <Button href="/contact" size="lg">
        Get a Free Estimate
      </Button>
      <Button href={`tel:${site.phoneE164}`} size="lg" variant="inverse">
        <Icon name="lucide:phone" class="size-5" aria-hidden="true" />
        {site.phone}
      </Button>
    </div>
  </Container>
</section>
