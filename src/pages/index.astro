---
import { Icon } from "astro-icon/components";
import { site } from "@/site.config";
import BaseLayout from "@/components/layout/BaseLayout.astro";
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
import { getServices, serviceHref } from "@/lib/services";

// Placeholder home page. Real sections arrive in Phase 3.
const services = await getServices();
const title = `${site.name} | ${site.tagline} in ${site.address.locality}, ${site.address.region}`;
const description = `${site.name} is a ${site.tagline.toLowerCase()} serving ${site.serviceAreas.join(", ")}. Call ${site.phone} for a free estimate.`;
---

<BaseLayout title={title} description={description}>
  <section class="bg-primary text-white">
    <Container class="py-20 lg:py-28">
      <p class="font-heading text-sm font-semibold tracking-wider text-accent-light uppercase">
        {site.tagline}
      </p>
      <h1 class="mt-3 max-w-3xl text-4xl font-extrabold text-white sm:text-5xl">
        Building and remodeling in {site.address.locality}, done right the first time.
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-white/85">
        TODO: client copy. Placeholder home page; the full hero, trust bar, and service sections
        come in Phase 3.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="/contact" size="lg">
          Get a Free Estimate
        </Button>
        <Button href={`tel:${site.phoneE164}`} size="lg" variant="inverse">
          <Icon name="lucide:phone" class="size-5" aria-hidden="true" />
          {site.phone}
        </Button>
      </div>
    </Container>
  </section>

  <section id="services" class="py-16">
    <Container>
      <h2 class="text-3xl font-bold">Services</h2>
      <!-- Interim list; replaced by the ServicesGrid section in Phase 3. -->
      <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {services.map((s) => (
          <li>
            <a
              href={serviceHref(s)}
              class="flex items-center gap-3 rounded-lg border border-line p-4 font-heading font-semibold hover:border-primary hover:text-primary"
            >
              <Icon name={`lucide:${s.data.icon}`} class="size-6 text-primary" aria-hidden="true" />
              {s.data.title}
            </a>
          </li>
        ))}
      </ul>
    </Container>
  </section>
</BaseLayout>
