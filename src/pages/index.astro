---
import { getHome, getTestimonials } from "@/lib/content";
import { getServices, serviceHref } from "@/lib/services";
import BaseLayout from "@/components/layout/BaseLayout.astro";
import Hero from "@/components/sections/Hero.astro";
import TrustBar from "@/components/sections/TrustBar.astro";
import ServicesGrid from "@/components/sections/ServicesGrid.astro";
import WhyUs from "@/components/sections/WhyUs.astro";
import ProcessSteps from "@/components/sections/ProcessSteps.astro";
import Gallery, { type GalleryImage } from "@/components/sections/Gallery.astro";
import Testimonials from "@/components/sections/Testimonials.astro";
import ServiceAreas from "@/components/sections/ServiceAreas.astro";
import FAQ from "@/components/sections/FAQ.astro";
import CTABanner from "@/components/sections/CTABanner.astro";

const home = await getHome();
const services = await getServices();
const testimonials = await getTestimonials();

// One photo per service, linked to its page, until a projects collection exists.
const gallery: GalleryImage[] = services.flatMap((s) => {
  const first = s.data.gallery[0];
  return first
    ? [{ src: first.src, alt: first.alt, caption: { text: s.data.title, href: serviceHref(s) } }]
    : [];
});
---

<BaseLayout title={home.metaTitle} description={home.metaDescription}>
  <Hero {...home.hero} />
  <TrustBar items={home.trust} />
  <ServicesGrid {...home.services} services={services} />
  <WhyUs {...home.whyUs} />
  <ProcessSteps heading={home.process.heading} steps={home.process.steps} />
  <Gallery {...home.gallery} images={gallery.slice(0, 6)} tone="surface" />
  <Testimonials {...home.testimonials} testimonials={testimonials.slice(0, 3)} />
  <ServiceAreas {...home.serviceAreas} tone="surface" />
  <FAQ heading={home.faq.heading} items={home.faq.items} />
  <CTABanner {...home.cta} />
</BaseLayout>
