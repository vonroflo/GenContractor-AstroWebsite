---
import { Icon } from "astro-icon/components";
import { site } from "@/site.config";
import { getServices, serviceHref } from "@/lib/services";
import BaseLayout from "@/components/layout/BaseLayout.astro";
import Section from "@/components/ui/Section.astro";
import Button from "@/components/ui/Button.astro";

const services = await getServices();
---

<BaseLayout
  title={`Page Not Found | ${site.name}`}
  description={`The page you're looking for doesn't exist. Browse ${site.name}'s services or contact us for a free estimate.`}
  noindex
>
  <Section>
    <div class="mx-auto max-w-2xl text-center">
      <span class="mx-auto flex size-16 items-center justify-center rounded-full bg-primary-light text-primary">
        <Icon name="lucide:search-x" class="size-8" aria-hidden="true" />
      </span>
      <p class="mt-6 font-heading font-semibold text-primary">404</p>
      <h1 class="mt-2 text-4xl font-extrabold sm:text-5xl">We can't find that page.</h1>
      <p class="mt-5 text-lg text-muted">
        It may have moved, or the link may be out of date. Try one of our services below, or get in
        touch and we'll help.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button href="/" variant="primary" size="lg">
          <Icon name="lucide:house" class="size-5" aria-hidden="true" />
          Go to homepage
        </Button>
        <Button href="/contact" size="lg">
          Get a Free Estimate
        </Button>
      </div>
    </div>

    <nav aria-labelledby="popular-heading" class="mx-auto mt-16 max-w-3xl">
      <h2 id="popular-heading" class="text-center text-xl font-bold">
        Our services
      </h2>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2">
        {services.map((s) => (
          <li>
            <a
              href={serviceHref(s)}
              class="flex items-center gap-3 rounded-lg border border-line p-4 font-heading font-semibold hover:border-primary hover:text-primary"
            >
              <Icon
                name={`lucide:${s.data.icon}`}
                class="size-5 shrink-0 text-primary"
                aria-hidden="true"
              />
              {s.data.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </Section>
</BaseLayout>
