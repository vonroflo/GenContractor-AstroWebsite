---
import { render } from "astro:content";
import { Icon } from "astro-icon/components";
import { site } from "@/site.config";
import { getPage } from "@/lib/content";
import { formatCityLine, formatHours } from "@/lib/format";
import BaseLayout from "@/components/layout/BaseLayout.astro";
import PageHeader from "@/components/sections/PageHeader.astro";
import Section from "@/components/ui/Section.astro";
import Prose from "@/components/ui/Prose.astro";
import Button from "@/components/ui/Button.astro";

const page = await getPage("contact");
const { data } = page;
const { Content } = await render(page);

const mapQuery = encodeURIComponent(
  `${site.address.locality}, ${site.address.region} ${site.address.postalCode}`,
);
const mapEmbed = `https://www.google.com/maps?q=${mapQuery}&output=embed`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${mapQuery}`;
---

<BaseLayout title={data.metaTitle} description={data.metaDescription}>
  <PageHeader heading={data.heading} intro={data.intro} crumbs={[{ label: "Contact" }]} />

  <Section>
    <div class="grid grid-cols-[minmax(0,1fr)] gap-12 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
      <div>
        <!-- QuoteForm lands here in Phase 4. -->
        <div
          id="quote-form"
          class="rounded-xl border-2 border-dashed border-line p-8 text-center text-muted"
        >
          <Icon
            name="lucide:clipboard-list"
            class="mx-auto size-10 text-primary"
            aria-hidden="true"
          />
          <p class="mt-3 font-heading font-semibold text-ink">
            The estimate request form is coming soon.
          </p>
          <p class="mt-2">In the meantime, call or email us and we'll get right back to you.</p>
          <div class="mt-6 flex flex-wrap justify-center gap-3">
            <Button href={`tel:${site.phoneE164}`} variant="primary">
              <Icon name="lucide:phone" class="size-5" aria-hidden="true" />
              {site.phone}
            </Button>
            <Button href={`mailto:${site.email}`} variant="outline">
              Email us
            </Button>
          </div>
        </div>

        <Prose class="mt-12">
          <Content />
        </Prose>
      </div>

      <aside class="space-y-6">
        <div class="rounded-xl border border-line bg-surface p-6">
          <h2 class="text-xl font-bold">Contact details</h2>
          <ul class="mt-5 space-y-4">
            <li class="flex gap-3">
              <Icon
                name="lucide:phone"
                class="mt-0.5 size-5 shrink-0 text-primary"
                aria-hidden="true"
              />
              <div>
                <p class="text-sm text-muted">Phone</p>
                <a
                  href={`tel:${site.phoneE164}`}
                  class="font-semibold hover:text-primary hover:underline"
                >
                  {site.phone}
                </a>
              </div>
            </li>
            <li class="flex gap-3">
              <Icon
                name="lucide:mail"
                class="mt-0.5 size-5 shrink-0 text-primary"
                aria-hidden="true"
              />
              <div class="min-w-0">
                <p class="text-sm text-muted">Email</p>
                <a
                  href={`mailto:${site.email}`}
                  class="font-semibold break-all hover:text-primary hover:underline"
                >
                  {site.email}
                </a>
              </div>
            </li>
            <li class="flex gap-3">
              <Icon
                name="lucide:clock"
                class="mt-0.5 size-5 shrink-0 text-primary"
                aria-hidden="true"
              />
              <div>
                <p class="text-sm text-muted">Hours</p>
                {site.hours.map((h) => (
                  <p class="font-semibold">{formatHours(h)}</p>
                ))}
              </div>
            </li>
            <li class="flex gap-3">
              <Icon
                name="lucide:map-pin"
                class="mt-0.5 size-5 shrink-0 text-primary"
                aria-hidden="true"
              />
              <div>
                <p class="text-sm text-muted">Based in</p>
                <p class="font-semibold">{formatCityLine(site.address)}</p>
                <a href="/service-area" class="text-sm text-primary underline underline-offset-4">
                  See all cities we serve
                </a>
              </div>
            </li>
          </ul>
        </div>

        <div class="overflow-hidden rounded-xl border border-line bg-surface">
          <iframe
            src={mapEmbed}
            title={`Map of ${site.address.locality}, ${site.address.region}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="aspect-[4/3] w-full border-0"
          ></iframe>
          <a
            href={mapLink}
            rel="noopener"
            class="block px-4 py-3 text-sm font-semibold text-primary underline underline-offset-4"
          >
            Open in Google Maps
          </a>
        </div>
      </aside>
    </div>
  </Section>
</BaseLayout>
