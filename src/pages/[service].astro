---
import type { GetStaticPaths } from "astro";
import { getEntries, render } from "astro:content";
import { Picture } from "astro:assets";
import { Icon } from "astro-icon/components";
import { site } from "@/site.config";
import { getServices, serviceHref, type Service } from "@/lib/services";
import BaseLayout from "@/components/layout/BaseLayout.astro";
import Container from "@/components/ui/Container.astro";
import Section from "@/components/ui/Section.astro";
import Button from "@/components/ui/Button.astro";
import Prose from "@/components/ui/Prose.astro";
import ProcessSteps from "@/components/sections/ProcessSteps.astro";
import Gallery from "@/components/sections/Gallery.astro";
import FAQ from "@/components/sections/FAQ.astro";
import CTABanner from "@/components/sections/CTABanner.astro";

export const getStaticPaths = (async () => {
  const services = await getServices();
  return services.map((service) => ({
    params: { service: service.data.slug },
    props: { service },
  }));
}) satisfies GetStaticPaths;

interface Props {
  service: Service;
}

const { service } = Astro.props;
const { data } = service;
const { Content } = await render(service);
const related = (await getEntries(data.related)).filter((s) => !s.data.draft);
---

<BaseLayout title={data.metaTitle} description={data.metaDescription}>
  <section class="bg-primary text-white">
    <Container class="grid grid-cols-[minmax(0,1fr)] items-center gap-10 py-12 lg:grid-cols-2 lg:py-20">
      <div>
        <nav aria-label="Breadcrumb" class="text-sm text-white/80">
          <ol class="flex flex-wrap items-center gap-1">
            <li>
              <a href="/" class="hover:text-white hover:underline">
                Home
              </a>
            </li>
            <li aria-hidden="true">
              <Icon name="lucide:chevron-right" class="size-4" />
            </li>
            <li aria-current="page" class="text-white">
              {data.title}
            </li>
          </ol>
        </nav>
        <h1 class="mt-4 text-4xl font-extrabold text-white sm:text-5xl">{data.heroHeading}</h1>
        <p class="mt-5 text-lg text-white/85">{data.heroSubheading}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/contact" size="lg">
            Get a Free Estimate
          </Button>
          <Button href={`tel:${site.phoneE164}`} size="lg" variant="inverse">
            <Icon name="lucide:phone" class="size-5" aria-hidden="true" />
            {site.phone}
          </Button>
        </div>
      </div>
      <Picture
        src={data.heroImage}
        alt={data.heroImageAlt}
        formats={["avif", "webp"]}
        widths={[480, 800, 1200, 1600]}
        sizes="(min-width: 1024px) 600px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="aspect-[8/5] w-full rounded-2xl object-cover shadow-xl"
      />
    </Container>
  </section>

  <Section>
    <div class="grid grid-cols-[minmax(0,1fr)] gap-12 lg:grid-cols-[minmax(0,1fr)_340px]">
      <Prose>
        <Content />
      </Prose>

      <aside class="space-y-6 lg:sticky lg:top-28 lg:self-start">
        <div class="rounded-xl border border-line bg-surface p-6">
          <h2 class="text-xl font-bold">What we offer</h2>
          <ul class="mt-4 space-y-3">
            {data.offerings.map((offering) => (
              <li class="flex gap-3">
                <Icon
                  name="lucide:circle-check"
                  class="mt-0.5 size-5 shrink-0 text-primary"
                  aria-hidden="true"
                />
                <span>{offering}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-xl bg-primary-dark p-6 text-white">
          <p class="font-heading text-lg font-bold">Free estimates</p>
          <p class="mt-2 text-sm text-white/85">
            Licensed contractor, CSLB #{site.license.number}.
          </p>
          <Button href="/contact" class="mt-4 w-full">
            Request an Estimate
          </Button>
        </div>
      </aside>
    </div>
  </Section>

  <ProcessSteps heading="What does the process look like?" steps={data.process} tone="surface" />

  <Gallery
    heading="Recent projects"
    images={data.gallery.map((g) => ({ src: g.src, alt: g.alt }))}
  />

  <FAQ heading="Frequently asked questions" items={data.faqs} tone="surface" />

  {related.length > 0 && (
    <Section aria-labelledby="related-heading">
      <h2 id="related-heading" class="text-3xl font-bold">
        Related services
      </h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((r) => (
          <li>
            <a
              href={serviceHref(r)}
              class="group flex h-full gap-4 rounded-xl border border-line p-5 transition hover:border-primary hover:shadow-md"
            >
              <Icon
                name={`lucide:${r.data.icon}`}
                class="size-8 shrink-0 text-primary"
                aria-hidden="true"
              />
              <span>
                <span class="block font-heading font-semibold group-hover:text-primary">
                  {r.data.title} in {site.address.locality}
                </span>
                <span class="mt-1 block text-sm text-muted">{r.data.summary}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </Section>
  )}

  <CTABanner />
</BaseLayout>
